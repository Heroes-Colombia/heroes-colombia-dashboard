rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // Helper Functions - Schema V2
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Get user data helper - ONLY use outside of /users collection rules
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is admin (V1 + V2 compatibility) - ONLY use outside of /users collection
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().user_type == 'admin' ||
        getUserData().permission == 'admin'
      );
    }

    // Check if user data (already loaded) is admin - Use INSIDE /users collection
    function isUserAdmin(userData) {
      return userData.user_type == 'admin' || userData.permission == 'admin';
    }

    // Check if user is part of a business team (V2 schema)
    function isBusinessTeamMember(businessId) {
      return isAuthenticated() &&
             getUserData().user_type == 'business_team' &&
             getUserData().business_roles != null &&
             getUserData().business_roles.size() > 0;
    }

    // Check if user is owner or manager of a business (simplified)
    function isBusinessOwnerOrManager(businessId) {
      return isAuthenticated() &&
             getUserData().business_roles != null &&
             getUserData().business_roles.size() > 0;
    }

    // ============================================================================
    // Users Collection (Authentication & Profiles)
    // ============================================================================

    match /users/{userId} {
      // CRITICAL: Users can ALWAYS read their own profile (avoids circular dependency)
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Admins can read any user profile (checked AFTER they can read their own)
      allow read: if isAuthenticated() &&
                     request.auth.uid != userId &&
                     isAdmin();

      // Business staff can read consumer profiles (checked AFTER own profile)
      allow read: if isAuthenticated() &&
                     request.auth.uid != userId &&
                     resource.data.user_type == 'consumer' &&
                     getUserData().user_type == 'business_team';

      // Allow unauthenticated users to validate invite codes during signup
      // SECURITY: Only allows reading military users (permission: 'user') with an invite_code
      // This is needed for the signup flow when users enter a referral code
      allow read: if !isAuthenticated() &&
                     resource.data.permission == 'user' &&
                     resource.data.invite_code != null;

      // Users can update their own profile (limited fields)
      allow update: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_type', 'permission', 'business_roles', 'verified', 'status']);

      // Admins can update any profile
      allow update: if isAuthenticated() && isAdmin();

      // Allow user creation during registration (by themselves)
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Admins can create users
      allow create: if isAuthenticated() && isAdmin();

      // Only admins can delete users
      allow delete: if isAuthenticated() && isAdmin();
    }

    // ============================================================================
    // Businesses Collection (Business Profiles) - Schema V2
    // ============================================================================

    match /businesses/{businessId} {
      // Public can read active businesses, team members can read their own, admins can read all
      allow read: if resource.data.status == 'active' || isBusinessTeamMember(businessId) || isAdmin();

      // Owners/managers can update their business, admins can update any
      allow update: if isBusinessOwnerOrManager(businessId) || isAdmin();

      // Allow creation during registration
      allow create: if isAuthenticated() || isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();

      // ========================================================================
      // Subcollection: businesses/{businessId}/locations
      // ========================================================================

      match /locations/{locationId} {
        // Public can read active business locations, team can read/write their own
        allow read: if get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'active' ||
                       isBusinessTeamMember(businessId) ||
                       isAdmin();

        allow write: if isBusinessOwnerOrManager(businessId) || isAdmin();
      }
    }

    // ============================================================================
    // Promotions Collection (formerly advertisements) - Schema V2
    // ============================================================================

    match /promotions/{promotionId} {
      // Public can read active promotions, team can read their own
      allow read: if resource.data.status == 'active' ||
                     isBusinessTeamMember(resource.data.business_id) ||
                     isAdmin();

      // Owners/managers can create/update promotions
      allow create: if isAuthenticated() && (isBusinessOwnerOrManager(request.resource.data.business_id) || isAdmin());

      allow update: if isBusinessOwnerOrManager(resource.data.business_id) || isAdmin();

      // Owners and admins can delete
      allow delete: if isBusinessOwnerOrManager(resource.data.business_id) || isAdmin();
    }

    // ============================================================================
    // Legacy: Advertisements Collection (V1) - Keep for rollback
    // ============================================================================

    match /advertisements/{advertisementId} {
      // Same rules as promotions
      allow read: if resource.data.status == 'active' ||
                     isBusinessTeamMember(resource.data.business_id) ||
                     isAdmin();

      allow create: if isAuthenticated() && (isBusinessOwnerOrManager(request.resource.data.business_id) || isAdmin());

      allow update: if isBusinessOwnerOrManager(resource.data.business_id) || isAdmin();

      allow delete: if isBusinessOwnerOrManager(resource.data.business_id) || isAdmin();
    }

    // ============================================================================
    // Business Categories Collection - Schema V2
    // ============================================================================

    match /business_categories/{categoryId} {
      // Public read access for mobile app
      allow read: if true;

      // Only admins can write
      allow write: if isAdmin();
    }

    // ============================================================================
    // Subscriptions Collection - Schema V2
    // ============================================================================

    match /subscriptions/{subscriptionId} {
      // Business owners can read their subscription, admins can read all
      allow read: if isBusinessTeamMember(resource.data.business_id) || isAdmin();

      // Only admins can write (payment webhooks handled separately)
      allow write: if isAdmin();
    }

    // ============================================================================
    // Redemptions Collection (Future - Phase 2)
    // ============================================================================

    match /redemptions/{redemptionId} {
      // Business team can read their redemptions, consumers can read their own, admins can read all
      allow read: if (resource.data.business_id != null && isBusinessTeamMember(resource.data.business_id)) ||
                     request.auth.uid == resource.data.user_id ||
                     isAdmin();

      // Business staff can create redemptions
      allow create: if isAuthenticated() && (isBusinessOwnerOrManager(request.resource.data.business_id) || isAdmin());

      // Owners/managers can update redemption status
      allow update: if isBusinessOwnerOrManager(resource.data.business_id) || isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================================
    // Business Documents Collection (Verification uploads)
    // ============================================================================

    match /business_documents/{documentId} {
      // Business owners can read their documents, admins can read all
      allow read: if isBusinessTeamMember(resource.data.businessId) || isAdmin();

      // Business owners can upload documents
      allow create: if isAuthenticated() && isBusinessOwnerOrManager(request.resource.data.businessId);

      // Only admins can update (for verification status)
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================================
    // Platform Analytics & Admin Collections
    // ============================================================================

    match /platform_analytics/{analyticsId} {
      allow read, write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================================
    // Notifications
    // ============================================================================

    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;

      // Admins can create notifications
      allow create: if isAdmin();

      // Users can mark their own notifications as read
      allow update: if isAuthenticated() &&
                       resource.data.user_id == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'read_at', 'updated_at']);

      allow delete: if isAdmin();
    }

    // ============================================================================
    // Family Relationships Collection (V4 - Family Invitation System)
    // ============================================================================

    match /family_relationships/{relationshipId} {
      // Military personnel can read their own family relationships
      allow read: if isAuthenticated() &&
                     resource.data.primary_military_uid == request.auth.uid;

      // Beneficiaries can read their own relationship
      allow read: if isAuthenticated() &&
                     resource.data.family_member_uid == request.auth.uid;

      // Admins can read all relationships
      allow read: if isAdmin();

      // Allow creation during signup (beneficiary creates their relationship)
      allow create: if isAuthenticated() &&
                       request.resource.data.family_member_uid == request.auth.uid &&
                       request.resource.data.status == 'active' &&
                       request.resource.data.primary_military_uid is string &&
                       request.resource.data.invitation_code is string &&
                       request.resource.data.relationship in ['spouse', 'child', 'parent', 'sibling'];

      // Military personnel can revoke relationships (set status to 'revoked')
      allow update: if isAuthenticated() &&
                       resource.data.primary_military_uid == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revoked_at']) &&
                       request.resource.data.status == 'revoked';

      // Admins can update any relationship
      allow update: if isAdmin();

      // Only admins can delete relationships
      allow delete: if isAdmin();
    }

    // ============================================================================
    // Campaigns Collection (Automated Engagement System - Part A)
    // ============================================================================

    match /campaigns/{campaignId} {
      // Only admins can read campaigns (for review/approval)
      allow read: if isAdmin();

      // Only Cloud Functions can create campaigns (no client writes)
      // Admins can update for approval/rejection
      allow update: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ============================================================================
    // Campaign Metadata Collection (Enterprise Rotation Tracking)
    // ============================================================================

    match /campaigns_metadata/{metadataId} {
      // Only admins can read metadata
      allow read: if isAdmin();

      // Only Cloud Functions write to this (no client writes)
      allow write: if false;
    }

    // ============================================================================
    // Business Notifications Collection (Automated Reports - Part B)
    // ============================================================================

    match /business_notifications/{notificationId} {
      // Business owners can read their own notifications
      allow read: if isAuthenticated() &&
                     resource.data.business_id != null &&
                     isBusinessTeamMember(resource.data.business_id);

      // Admins can read all notifications
      allow read: if isAdmin();

      // Only Cloud Functions create these (no client writes)
      allow write: if false;
    }

    // ============================================================================
    // Analytics Events Collection (For tracking views, saves, clicks)
    // ============================================================================

    match /analytics_events/{eventId} {
      // Authenticated users can create analytics events (mobile app)
      allow create: if isAuthenticated();

      // Business owners can read analytics for their business
      allow read: if isAuthenticated() &&
                     resource.data.business_id != null &&
                     isBusinessTeamMember(resource.data.business_id);

      // Admins can read all analytics
      allow read: if isAdmin();

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // ============================================================================
    // Transactions Collection (Payment history)
    // ============================================================================

    match /transactions/{transactionId} {
      // Business owners can read their transactions
      allow read: if isAuthenticated() &&
                     resource.data.business_id != null &&
                     isBusinessTeamMember(resource.data.business_id);

      // Admins can read all
      allow read: if isAdmin();

      // Only Cloud Functions can write transactions
      allow write: if false;
    }

    // ============================================================================
    // Default Deny Rule
    // ============================================================================

    // Explicitly deny access to any collections not covered above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
